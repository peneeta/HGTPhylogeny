# Load required libraries
library(ape)
library(ggtree)
library(ggplot2)
# Read the tree
gyrA_tree <- read.tree("./related/gyrA/gyrA_aligned_trimmed.fasta.treefile.sunk")
# Create the ggtree object
p <- ggtree(gyrA_tree, size=0.6) +
geom_tiplab(size=3, align=TRUE, linetype="dotted", linesize=0.3) +
geom_text2(aes(label=label), hjust=-0.5, size=2.5) +
theme_tree2() +
labs(title="Phylogenetic Tree from treefile.sunk (gyrA)") +
theme(
plot.title = element_text(size=16, face="bold", hjust=0.5),
legend.position = "none"
)
# Extract max x position of tip labels to prevent clipping
tree_data <- ggplot_build(p)$data[[1]]
max_x <- max(tree_data$x, na.rm = TRUE)
# Extend x-axis limits
p <- p + xlim(0, max_x * 1.2)  # extend by 20%
ggsave("./conflicting_trees/gyrA_relatedSpecies_fullGene.png", plot = p, width = 10, height = 8, dpi = 300)
