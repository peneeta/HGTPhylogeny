setwd("~/go/bioinformatics/Project/HGTPhylogeny/intragenic_conflict")
# Load required libraries
library(ape)
library(ggtree)
library(ggplot2)
# Read the tree
gyrA_tree <- read.tree("./related/gyrA/gyrA_aligned_trimmed.fasta.treefile.sunk")
# Basic ggtree plot with bootstrap values shown on the branches
ggtree(gyrA_tree, size=0.8) +
geom_tiplab(size=3, align=TRUE, linetype="dotted", linesize=0.3) +   # nicer tip labels
geom_text2(aes(label=label), hjust=-.3, size=2.5, subset = !isTip) +  # show edge labels (bootstraps)
theme_tree2() +                                                       # horizontal tree with axis
labs(title="Phylogenetic Tree from treefile.sunk (gyrA)") +
theme(
plot.title = element_text(size=16, face="bold", hjust=0.5),
legend.position = "none"
)
View(gyrA_tree)
ggsave("./conflicting_trees/gyrA_base_tree.png", plot = p, width = 10, height = 8, dpi = 300)
